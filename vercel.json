{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":null,
  "buildCommand":"npm run build",
  "outputDirectory":"public",
  "functions":{"api/index.mjs":{"maxDuration":60,"includeFiles":"public/demo.json"}},
  "rewrites":[{"source":"/api/:path*","destination":"/api/index?route=:path*"}],
  "headers":[{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}
  ]},{"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},{"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]}]
}
