# Copy to .env.local. Restart the server after changes. Never put keys in public/.
SERPAPI_KEY=
TRAVELPAYOUTS_TOKEN=
# Conservative LOCAL request-attempt ceilings, not an account balance.
SERPAPI_MONTHLY_LIMIT=250
TRAVELPAYOUTS_MONTHLY_LIMIT=100
PORT=3000
# Default loopback. For phone/LAN testing set HOST=0.0.0.0 and use HTTPS.
HOST=127.0.0.1
